# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Connect (or Project Settings → API Keys).
# .env.local is ignored by git, so your keys never get pushed to GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NEVER put the service_role / secret key in a NEXT_PUBLIC_ variable.
